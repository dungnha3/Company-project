# Project-wide ignores

# Logs & temp output
logs/
*.log
*.gz
*.txt
!README.txt

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# AI tools
.agents/
.agent/
_agents/
_agent/
.gemini/

# Temp files
*.tmp
*.bak
*.cache

# =====================================================
# SECURITY - NEVER COMMIT THESE FILES!
# =====================================================

# Environment files
.env
.env.*

# Application secrets
**/application-local.properties
**/application-prod.properties
**/application-secret.properties

# Firebase credentials
firebase-*.json
*-firebase-adminsdk-*.json
google-services.json

# SSL/TLS certificates
*.pem
*.key
*.crt
*.p12
*.jks

# AWS/Cloud credentials
.aws/
credentials.json

# =====================================================
# Build outputs & Dependencies
# =====================================================

# Dependencies (will be handled by subproject gitignores)
node_modules/

# Java
target/
*.class
*.jar
*.war

# Python
__pycache__/
*.pyc
venv/

# Uploads (user data)
uploads/
!uploads/.gitkeep
